# Copy to .env (which is git-ignored) and fill in. Used only by `npm run audio`.
ELEVENLABS_API_KEY=
# Voice ids from your ElevenLabs voice library.
# Agent: warm, unhurried, mid-pitched. Callum: British male, conversational.
ELEVENLABS_VOICE_AGENT=
ELEVENLABS_VOICE_CALLUM=
# Optional. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL=
